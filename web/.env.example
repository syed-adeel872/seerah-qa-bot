# ============================================================
# Google AI Studio — Gemini 2.5 (OpenAI-compatible endpoint)
# Default. Copy to .env.local and fill in your key.
# Get a key at https://aistudio.google.com/apikey
# ============================================================
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Primary model. gemini-2.5-flash and gemini-2.5-flash-lite are deprecated for
# new accounts (404); the client falls back through LLM_MODEL_FALLBACKS.
LLM_MODEL=gemini-2.5-flash
# Ordered fallback chain tried when the primary 404s / errors.
LLM_MODEL_FALLBACKS=gemini-2.5-flash-lite,gemini-3.5-flash-lite

# ------------------------------------------------------------
# Alternative: native Generative Language API (uncomment to use)
# Used only when the LLM_* trio above is NOT fully set.
# ------------------------------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta